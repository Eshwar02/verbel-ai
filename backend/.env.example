# Max characters accepted per request
MAX_TEXT_LENGTH=5000

# Comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Future provider keys (not used by gTTS; keep out of source control) ---
# TTS_API_KEY=your_api_key
# TTS_REGION=your_region
# TTS_ENDPOINT=your_endpoint
