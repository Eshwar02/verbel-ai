# Max characters accepted per request
MAX_TEXT_LENGTH=5000

# Comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mistral: AI enhancement (POST /api/enhance) + neural TTS (Voxtral) ---
# One key powers both. If unset, /api/enhance returns 503 and the neural
# engine is hidden (Standard/gTTS still works with no key).
MISTRAL_API_KEY=your-mistral-api-key
# Optional: override the Voxtral TTS model.
# VOXTRAL_MODEL=voxtral-mini-tts-2603

# --- Supabase (auth + cloud history) ---
SUPABASE_URL=https://your-project.supabase.co
# Public anon key — used for email/password auth flows.
SUPABASE_ANON_KEY=your-anon-key
# Backend-only service role SECRET key — never expose to the frontend.
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Future provider keys (not used by gTTS; keep out of source control) ---
# TTS_API_KEY=your_api_key
# TTS_REGION=your_region
# TTS_ENDPOINT=your_endpoint
